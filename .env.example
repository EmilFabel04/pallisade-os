# Copy this file to .env.local and fill in your key.
# Enables real AI (Claude Sonnet 4.6 at high effort) for Call Summaries and the
# Business Review. Without it, the app falls back to built-in mock summaries.
ANTHROPIC_API_KEY=

# Optional: override the model that powers The Brain (CEO/strategist).
# Defaults to claude-sonnet-4-6. Set to a more capable model for deeper reasoning.
# BRAIN_MODEL=claude-sonnet-4-6

# --- Google integration (Gmail + Calendar, optional) ---
# Powers the Inbox (read Gmail), the Agenda (read/write Google Calendar), booking
# calls from a lead, and the advisor's email/calendar tools — all on one OAuth
# connection. In Google Cloud Console: create a "Web application" OAuth client,
# ENABLE both the "Gmail API" and the "Google Calendar API", and register this
# redirect URI:
#   http://localhost:3000/api/gmail/callback
# Then paste the client credentials below and restart the app. Leave blank to
# keep the integration dormant (the Inbox shows setup instructions instead).
# Note: an account connected before calendar was added must reconnect once to
# grant calendar access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override if you run on a different port/host:
# GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# --- Voice input (optional) ---
# Enables the 🎙 mic buttons (Sales Advisor, interaction notes, daily review,
# lead notes) — records your voice and transcribes it with OpenAI Whisper.
# Get a key at https://platform.openai.com/api-keys (pay-as-you-go, ~$0.006/min).
# Without it, the mic buttons appear disabled with a hint.
OPENAI_API_KEY=
# Optional: override the transcription model (default whisper-1):
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# News section (all optional)
# Raises the GitHub Search API rate limit; the feed works unauthenticated too.
GITHUB_TOKEN=
# Override the model used for news curation (defaults to claude-sonnet-4-6).
NEWS_MODEL=
# Improves the Reddit source. Reddit blocks unauthenticated JSON access, so
# without these the feed uses the public RSS endpoint: it works, but the ranking
# is merged across your subreddits (a busy one can crowd out a quiet one) and
# upvote counts are unavailable. With credentials each subreddit is fetched
# separately with scores, at 100 requests/minute.
# Create a "script" app at https://www.reddit.com/prefs/apps — the client ID is
# the string under the app name, the secret is the "secret" field.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Authentication (required in production) ---
# Single-user login via Google (Auth.js). Only AUTH_ALLOWED_EMAIL may sign in.
# Locally, if AUTH_GOOGLE_ID is unset in development, the login gate is bypassed
# so you can run the app without Google configured. Production ALWAYS enforces.
# Generate the secret with:  npx auth secret
AUTH_SECRET=
# A Google OAuth client SEPARATE from the Gmail/Calendar/Drive one above.
# Authorized redirect URI:  https://<your-domain>/api/auth/callback/google
#                    (and)  http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# The one email allowed to log in (e.g. you@gmail.com).
AUTH_ALLOWED_EMAIL=

# --- Database (Turso / libSQL) ---
# Production persistence. Leave BOTH blank locally to use the on-disk SQLite
# file at data/pallisade.db (default). In production set these to your Turso DB:
#   turso db create pallisade-os
#   turso db show pallisade-os --url        ->  TURSO_DATABASE_URL (libsql://...)
#   turso db tokens create pallisade-os     ->  TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Shared secret for the Content Studio daily cron. Vercel sets this header
# automatically on cron invocations once the variable exists on the project:
#   vercel env add CRON_SECRET production
# Generate with: openssl rand -hex 32
CRON_SECRET=
